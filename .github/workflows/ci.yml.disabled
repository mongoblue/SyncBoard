name: SyncBoard Enterprise CI (Corrected & Optimized)

on:
  push:
    branches: [ "main", "dev" ]
  pull_request:
    branches: [ "main", "dev" ]

jobs:
  # ===================================================
  # 任务 1：代码体检 (Lint)
  # ===================================================
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: |
          pip install flake8
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
          flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics

  # ===================================================
  # 任务 2：后端 API 测试
  # ===================================================
  api-test:
    needs: lint
    runs-on: ubuntu-latest
    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: ${{ secrets.DB_PASSWORD }}
          MYSQL_DATABASE: syncboard_test
        ports: ["3306:3306"]
        options: --health-cmd="mysqladmin ping" --health-interval=10s --health-timeout=5s --health-retries=5
      redis:
        image: redis:alpine
        ports: ["6379:6379"]
        options: --health-cmd "redis-cli ping" --health-interval 10s --health-timeout 5s --health-retries=5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - name: Install Dependencies
        working-directory: ./backend
        run: pip install -r requirements.txt
      - name: Run API Tests
        working-directory: ./backend
        env:
          DB_HOST: 127.0.0.1
          DB_PORT: 3306
          DB_USER: root
          DB_PASSWORD: ${{ secrets.DB_PASSWORD }}
          DB_NAME: syncboard_test
        run: |
          python manage.py migrate
          pytest tests/

  # ===================================================
  # 任务 3：端到端测试 (E2E Test)
  # 优化点：引入 Playwright 缓存 + Docker Buildx 缓存
  # ===================================================
  e2e-test:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 1. 配置 Docker Buildx 缓存 (加速构建)
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      # 2. 缓存 Playwright 浏览器 (加速安装)
      - name: Cache Playwright Browsers
        id: cache-playwright
        uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: ${{ runner.os }}-playwright-${{ hashFiles('**/requirements.txt') }}

      # 3. 必须保留：生成 .env 文件
      - name: Create .env file
        run: |
          echo "DB_ENGINE=django.db.backends.mysql" >> .env
          echo "DB_NAME=flowspace" >> .env
          echo "DB_USER=root" >> .env
          echo "DB_PASSWORD=${{ secrets.DB_PASSWORD }}" >> .env
          echo "DB_HOST=db" >> .env
          echo "DB_PORT=3306" >> .env
          echo "DEBUG=True" >> .env
          echo "ALLOWED_HOSTS=*" >> .env
          echo "LOGIN_THROTTLE_RATE=10000/minute" >> .env
          echo "ANON_THROTTLE_RATE=10000/min" >> .env
          echo "USER_THROTTLE_RATE=10000/min" >> .env
          echo "AI_THROTTLE_RATE=10000/minute" >> .env
          echo "WS_THROTTLE_RATE=10000/minute" >> .env

      # 4. 必须保留：生成 Override 文件 (防止脑裂)
      - name: Create Docker Compose Override
        run: |
          cat <<EOF > docker-compose.override.yml
          services:
            backend:
              env_file:
                - .env
          EOF

      # 5. 启动环境 (利用 Cache)
      - name: Start Full Stack Environment
        run: |
          # 尝试使用 inline cache
          docker compose build --build-arg BUILDKIT_INLINE_CACHE=1
          docker compose up -d
          
      # 6. 等待前端 (用 curl 替代 sleep 15)
      - name: Check Frontend Availability
        run: |
          timeout 60s bash -c 'until curl -s http://localhost > /dev/null; do sleep 3; done'
          echo "✅ Frontend is up!"

      # 7. 必须保留：修复权限 (防止 Python 报错)
      - name: Fix Docker Permissions
        run: |
          sudo chown -R $USER:$USER .
          sudo chmod -R 777 redis_data || true
          sudo chmod -R 777 mysql_data || true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Install Dependencies
        working-directory: ./backend
        run: |
          pip install -r requirements.txt
          pip install pytest-playwright
          # 利用缓存判断是否需要下载浏览器
          if [ "${{ steps.cache-playwright.outputs.cache-hit }}" != "true" ]; then
            playwright install chromium --with-deps
          fi

      # 8. 必须保留：在容器内准备数据 & 强制改密
      - name: Prepare E2E Data
        working-directory: ./backend
        run: |
          # 保持使用 backend 容器执行，确保环境一致
          docker compose exec -T backend python manage.py migrate
          docker compose exec -T backend python manage.py seed_ci_data
          # 强制修改密码，确保测试账号可用
          docker compose exec -T backend python manage.py shell -c "from django.contrib.auth import get_user_model; User=get_user_model(); u=User.objects.get(username='mongoblue'); u.set_password('13579mnb'); u.save(); print('✅ Password reset')"

      - name: Run E2E Tests
        working-directory: ./
        env:
          BASE_URL: http://localhost
          API_URL: http://localhost:8000
        run: pytest e2e/

      - name: Debug Failure (Print Logs)
        if: failure()
        run: |
          docker compose logs backend
          docker compose logs frontend

  # ===================================================
  # 任务 4：性能压测 (Load Test)
  # 优化点：并行执行 (needs: lint)，但必须保留全套初始化逻辑
  # ===================================================
  load-test:
    needs: lint  # ✅ 并行优化：不再等待 E2E
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # ⚠️ 注意：因为是并行跑，这是全新的机器，必须重新生成 .env 和启动环境
      - name: Create .env and Override
        run: |
          echo "DB_ENGINE=django.db.backends.mysql" >> .env
          echo "DB_NAME=flowspace" >> .env
          echo "DB_USER=root" >> .env
          echo "DB_PASSWORD=${{ secrets.DB_PASSWORD }}" >> .env
          echo "DB_HOST=db" >> .env
          echo "DB_PORT=3306" >> .env
          echo "LOGIN_THROTTLE_RATE=10000/minute" >> .env
          echo "ANON_THROTTLE_RATE=10000/min" >> .env
          echo "USER_THROTTLE_RATE=10000/min" >> .env
          echo "AI_THROTTLE_RATE=10000/minute" >> .env
          echo "WS_THROTTLE_RATE=10000/minute" >> .env
          cat <<EOF > docker-compose.override.yml
          services:
            backend:
              env_file:
                - .env
          EOF

      - name: Start Full Stack Environment
        run: |
          docker compose up -d
          timeout 60s bash -c 'until curl -s http://localhost:8000/health > /dev/null; do sleep 2; done'

      - name: Prepare Load Test Data
        run: |
          # 必须修复权限，否则 docker exec 可能失败
          sudo chown -R $USER:$USER .
          # 必须造数据，否则 Locust 登录会 404
          docker compose exec -T backend python manage.py migrate
          docker compose exec -T backend python manage.py seed_ci_data
          docker compose exec -T backend python manage.py shell -c "from django.contrib.auth import get_user_model; User=get_user_model(); u=User.objects.get(username='mongoblue'); u.set_password('13579mnb'); u.save();"

      - name: Run Locust Smoke Test
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: |
          pip install locust
          locust -f backend/performance/locustfile.py \
            --headless -u 50 -r 5 --run-time 30s \
            --host http://localhost:8000
