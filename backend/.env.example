# Django
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
# 开发/测试环境：包含 testserver（Django test client 默认 Host）
# 生产环境必须改为显式主机名，例如：ALLOWED_HOSTS=api.syncboard.example.com
# 禁止使用 "*"（DEBUG=False 时 Django 会拒绝）
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (MySQL)
DB_NAME=syncboard
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1

# Redis (used by channels, celery)
REDIS_HOST=127.0.0.1

# Elasticsearch (optional, for full-text search)
HAYSTACK_URL=http://127.0.0.1:9200/

# AI (DeepSeek compatible, uses OPENAI_API_KEY)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Load testing
LOCUST_USERNAME=test_user
LOCUST_PASSWORD=password123

# ── 压力测试目标 URL 预检配置 ──────────────────────────────────
# 是否允许对 localhost 发起压测（生产环境应为 false）
PERF_ALLOW_LOCALHOST=false
# 允许压测的目标主机白名单（逗号分隔，空则不做限制）
PERF_ALLOWED_HOSTS=
# 是否禁止对内网地址（10.x, 172.16.x, 192.168.x）发起压测
PERF_BLOCK_PRIVATE_CIDRS=true
# 预检超时秒数
PERF_PROBE_TIMEOUT_SECONDS=5
# 永久禁止压测的 URL scheme（逗号分隔）
# PERF_BLOCKED_SCHEMES=file,ftp,gopher,javascript,data,vbscript
# 永久禁止压测的目标 host（逗号分隔，默认包含云 metadata 地址）
# PERF_BLOCKED_HOSTS=169.254.169.254,metadata.google.internal,100.100.100.200
# 永久禁止压测的 IP CIDR（逗号分隔）
# PERF_BLOCKED_CIDRS=169.254.0.0/16,100.64.0.0/10
# 最大并发压测数
PERF_MAX_CONCURRENT=5
